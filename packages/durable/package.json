{
  "name": "@tiberjs/durable",
  "version": "0.1.0",
  "description": "Durable Runner job wrapping with dynamic checkpoints, retries, cancellation, and recovery.",
  "author": "miinhho",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "tiberjs-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rspack build --config ../../rspack.config.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -w exec vitest run --project @tiberjs/durable"
  },
  "dependencies": {
    "@tiberjs/di": "^0.1.1",
    "@tiberjs/runner": "^0.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiberjs/manager.git",
    "directory": "packages/durable"
  },
  "engines": {
    "node": ">=24"
  }
}
