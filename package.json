{
  "name": "tiberjs-manager-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@rspack/cli": "2.2.3",
    "@rspack/core": "2.2.3",
    "@types/node": "^24",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
