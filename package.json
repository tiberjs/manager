{
  "name": "@tiberjs/manager",
  "version": "0.1.0",
  "description": "Durable Runner job wrapping with dynamic checkpoints, retries, cancellation, and recovery.",
  "author": "miinhho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiberjs/manager.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rspack build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tiberjs/runner": "^0.1.1"
  },
  "devDependencies": {
    "@rspack/cli": "2.2.3",
    "@rspack/core": "2.2.3",
    "@types/node": "^24",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
